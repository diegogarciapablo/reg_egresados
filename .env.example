# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=postgres123
DB_NAME=egresados_db

# pgAdmin (solo usado por docker-compose en desarrollo)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123

# App & CORS
PORT=3000
SESSION_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# URL pública del Frontend (usada para armar el link de verificación de correo)
FRONTEND_URL=http://localhost:8080

# ===================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP) - ELIGE UN BLOQUE
# Si no configuras ninguno, los enlaces de verificación saldrán en la consola.
# ===================================================================

# --- BLOQUE 1: Para Gmail (Requiere "Contraseña de aplicación" de 16 letras) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM="Directorio Egresados UAJMS <tu-correo@gmail.com>"

# --- BLOQUE 2: Para Correo Institucional / Hosting propio (cPanel, Plesk, etc.) ---
# SMTP_HOST=mail.uajms.edu.bo
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=egresados@uajms.edu.bo
# SMTP_PASS=tu-contraseña-institucional
# SMTP_FROM="Directorio Egresados UAJMS <egresados@uajms.edu.bo>"

# --- BLOQUE 3: Para Servicios Transaccionales (Brevo, Mailgun, Resend, etc.) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-usuario-smtp-o-apikey
# SMTP_PASS=tu-clave-smtp
# SMTP_FROM="Directorio Egresados UAJMS <notificaciones@tu-dominio.com>"
